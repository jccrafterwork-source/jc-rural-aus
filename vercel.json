{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/manus-storage/:path*", "destination": "/api/manus-storage?path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
